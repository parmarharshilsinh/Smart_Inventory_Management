# ==============================================================================
# Environment Configuration Template (Smart Inventory Management)
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT COMMIT REAL PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Server Port and Context Path
PORT=8080

# Database Connectivity (MySQL 8.4)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_management
DB_USERNAME=root
DB_PASSWORD=your_mysql_database_password_here

# Hibernate DDL Validation (validate in production, update only if explicitly approved)
HIBERNATE_DDL_AUTO=validate

# Spring Security & JWT Token Configuration (HMAC-SHA512 requires minimum 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://10.0.2.2:8081,http://10.0.2.2:8080,exp://*
